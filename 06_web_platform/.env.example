# Copy to .env (same folder as docker-compose.yml) and fill in. .env is never copied into the image.
# Curator token: long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave EMPTY to disable curator approval entirely (there is no built-in default token).
ANBIOGATE_ADMIN_TOKEN=
# Open the community sandbox to the public? Keep "false" while the paper is under review.
ENABLE_PUBLIC_SUBMISSION=false
# Public address of the site, used in the API examples shown on the portal
PUBLIC_BASE_URL=https://your-domain
